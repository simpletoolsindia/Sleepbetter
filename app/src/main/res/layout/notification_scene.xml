<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded bedtime reminder: a flip-book of scene frames (Pico and Lulu on
  the moon, the user's sounds) that the system plays as a short animation,
  with the message on top.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ViewFlipper
        android:id="@+id/scene_flipper"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:autoStart="true"
        android:flipInterval="150"
        android:background="@drawable/notification_scene_bg"
        android:clipToOutline="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/scene_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scene_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
